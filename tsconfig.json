{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "strict": true,
        "outDir": "./public/assets/js", // local de chegada dos arquivos após serem transpilados
        "rootDir": "./public/assets/ts", // arquivos que serão transpilados
        "esModuleInterop": true
    },
    "include": [
        "public/assets/ts/**/*.ts"
    ]
}